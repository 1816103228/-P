root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.bat]
# cmd.exe 在中文 Windows 上按 GBK 解码批处理，勿改为 UTF-8
charset = gbk
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[Makefile]
indent_style = tab
