# ============================================================
#  安全警告：复制本文件为 .env 后填写真实密钥。
#  .env 已在 .gitignore 中排除，不会被提交到版本控制。
#  请勿在任何公开场合泄露你的 API Key。
# ============================================================

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# LLM 请求超时（秒）与失败重试次数
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ---- 定时爬取 ----
CRAWL_TIME=02:00
CRAWL_INTERVAL_HOURS=24
SCHEDULER_TZ=Asia/Shanghai

# ---- 爬虫 ----
CRAWL_PAGES_PER_CATEGORY=10
CRAWL_REQUEST_DELAY=0.3
CRAWL_WORKERS=3
LEETCODE_CACHE_HOURS=72

# ---- 数据库 ----
DB_TIMEOUT_SECONDS=10

# ---- 语音通话服务 ----
VOICE_HOST=127.0.0.1
VOICE_PORT=8765
# edge=在线神经语音（微软晓晓，需联网）；local=浏览器本地语音
VOICE_TTS=edge
VOICE_NAME=zh-CN-XiaoxiaoNeural
VOICE_RATE=+0%
VOICE_PITCH=+2Hz
# 播报时开口打断的音量阈值（0~1，越大越难触发；回声抑制会滤掉扬声器声音）
VOICE_VAD_THRESHOLD=0.045
