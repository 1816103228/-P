# ============================================================
#  安全警告：复制本文件为 .env 后填写真实密钥。
#  .env 已在 .gitignore 中排除，不会被提交到版本控制。
#  请勿在任何公开场合泄露你的 API Key。
# ============================================================

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 总结报告专用模型（可选；留空则用 DEEPSEEK_MODEL，如 deepseek-reasoner 更深入但更慢更贵）
REPORT_MODEL=
# LLM 请求超时（秒）与失败重试次数
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ---- 定时爬取 ----
CRAWL_TIME=02:00
CRAWL_INTERVAL_HOURS=24
SCHEDULER_TZ=Asia/Shanghai

# ---- 爬虫 ----
CRAWL_PAGES_PER_CATEGORY=10
CRAWL_REQUEST_DELAY=0.3
CRAWL_WORKERS=3
LEETCODE_CACHE_HOURS=72

# ---- 数据库 ----
DB_TIMEOUT_SECONDS=10

# ---- 统一 Web 服务（Vue3 前端 + REST + 语音，单端口）----
# 多用户改造后 Streamlit 退役，FastAPI 同时托管静态前端与所有 API。
APP_HOST=127.0.0.1
APP_PORT=8765
# 登录令牌有效期（天）
TOKEN_TTL_DAYS=30

# ---- 语音通话 ----
# edge=微软edge-tts在线神经语音（晓晓，需联网）
# cosyvoice=阿里云百炼 CosyVoice（中文更自然、国内网络稳定，需 DASHSCOPE_API_KEY）
# local=浏览器本地语音
VOICE_TTS=edge
VOICE_NAME=zh-CN-XiaoxiaoNeural
VOICE_RATE=+0%
VOICE_PITCH=+2Hz
# 播报时开口打断的音量阈值（0~1，越大越难触发；回声抑制会滤掉扬声器声音）
VOICE_VAD_THRESHOLD=0.045

# ---- 阿里云百炼 CosyVoice（VOICE_TTS=cosyvoice 时必填）----
# 控制台获取：https://bailian.console.aliyun.com/  -> API-KEY
DASHSCOPE_API_KEY=
ASR_MODEL=paraformer-realtime-v2
ASR_SAMPLE_RATE=16000
COSYVOICE_MODEL=cosyvoice-v2
# 龙小淳v2=温暖甜美女声；其他音色见百炼官方音色列表
COSYVOICE_VOICE=longxiaochun_v2
COSYVOICE_FORMAT=mp3
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_RATE=1.0
COSYVOICE_PITCH=1.0

# ---- Web 地址（Vue3 前端访问，与 APP_PORT 保持一致）----
# WEB_URL=http://localhost:8765
